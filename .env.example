# Copy to .env.local for local development; add the same keys in Vercel → Project → Settings → Environment Variables.

# Postgres (Neon). On Vercel, adding Neon from the Storage tab sets this for you. Use the pooled URL.
DATABASE_URL=

# Better Auth. Generate the secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the site, no trailing slash. Optional on Vercel production (falls back to the production domain).
BETTER_AUTH_URL=http://localhost:3000

# Discord application (https://discord.com/developers/applications) → OAuth2.
# Add the redirect URL  <BETTER_AUTH_URL>/api/auth/callback/discord  for every environment you use.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot of the same (or another) application, invited to your server. Used to read members' roles.
DISCORD_BOT_TOKEN=
# Server (guild) ID whose roles grant permissions.
DISCORD_GUILD_ID=

# Shared secret for the bot license API (/api/bot/licenses). At least 32 characters:  openssl rand -hex 32
BOT_API_SECRET=

# Optional: extra owners, comma separated. The main owner is set in src/lib/access/config.ts.
OWNER_DISCORD_IDS=
