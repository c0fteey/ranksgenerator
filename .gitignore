# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design screenshots
/Screenshot_*.png

# local launcher (this PC only)
/baslat.bat

# Uiverse Galaxy archive (browse only, copy single elements into src)
/vendor/

# Claude Code: per-machine settings and the prebuilt Impeccable engine
/.claude/settings.local.json
/.claude/skills/impeccable/scripts/bin/

# Large skill (54 MB of media); restore with: npx skills experimental_install
/.claude/skills/video-shotcraft/
